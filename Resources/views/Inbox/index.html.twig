{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}inbox{% endblock %}
{% block headerTitle %}Atendimento{% endblock %}

{% block content %}
{{ includeStylesheet('plugins/MauticInboxBundle/Assets/css/inbox.css?inbox=20260913-alerts-1') }}
<div id="inbox-app" class="inbox-app"
     data-stream-url="{{ path('mautic_inbox_stream') }}"
     data-list-url="{{ path('mautic_inbox_list') }}"
     data-detail-url="{{ path('mautic_inbox_detail', {stateId: 0}) }}"
     data-timeline-url="{{ path('mautic_inbox_timeline', {stateId: 0}) }}"
     data-poll-url="{{ path('mautic_inbox_poll') }}"
     data-take-url="{{ path('mautic_inbox_take', {stateId: 0}) }}"
     data-state-url="{{ path('mautic_inbox_state', {stateId: 0}) }}"
     data-reply-url="{{ path('mautic_inbox_reply', {stateId: 0}) }}"
     data-note-url="{{ path('mautic_inbox_note', {stateId: 0}) }}"
     data-draft-url="{{ path('mautic_inbox_draft', {stateId: 0}) }}"
     data-canned-url="{{ path('mautic_inbox_canned') }}"
     data-csrf="{{ csrf_token('mautic_inbox') }}"
     data-current-user="{{ currentUserId }}">
    <div class="inbox-toolbar">
        <div class="inbox-product-heading"><span class="inbox-product-icon" data-icon="inbox"></span><div><strong>Atendimento</strong><span>Caixa de entrada compartilhada · <span id="inbox-live-status">Conectando…</span></span></div></div>
        <button type="button" id="inbox-sound" class="btn btn-default btn-sm" aria-pressed="false">Ativar som</button>
        <nav class="inbox-tabs" aria-label="Área de atendimento">
            <button class="active" data-view="inbox"><span data-icon="chat"></span>Conversas</button>
            <button data-view="comments"><span data-icon="comment"></span>Comentários</button>
            <button data-view="automation"><span data-icon="bolt"></span>Automações</button>
        </nav>
    </div>
    {% for notice in channelNotices|default([]) %}<div class="inbox-channel-notice" role="status">{{ notice }}</div>{% endfor %}
    <div class="inbox-workspace" data-inbox-only>
        <section class="inbox-list-column" aria-label="Lista de conversas">
            <div class="inbox-list-heading"><h2 id="inbox-list-heading">Conversas</h2><span id="inbox-list-total" class="inbox-counter">0</span><button class="inbox-icon-button" id="inbox-filter-toggle" title="Filtrar conversas" aria-label="Filtrar conversas" aria-expanded="false"><span data-icon="filter"></span></button></div>
            <div class="inbox-search-wrap"><span data-icon="search"></span><input id="inbox-search" type="search" placeholder="Buscar conversas" aria-label="Buscar conversas"></div>
            <nav class="inbox-queues" aria-label="Filas">
                <button data-queue="mine"><span>Minhas</span><b data-count="mine">0</b></button>
                <button data-queue="unassigned"><span>Não atribuídas</span><b data-count="unassigned">0</b></button>
                <button class="active" data-queue="all"><span>Todas</span><b data-count="all">0</b></button>
            </nav>
            <div class="inbox-filters hide" id="inbox-filter-panel">
                <label>Situação<select id="inbox-lifecycle" class="not-chosen form-control"><option value="active">Em andamento</option><option value="open">Abertas</option><option value="snoozed">Adiadas</option><option value="resolved">Resolvidas</option><option value="all">Todas</option></select></label>
                <label>Canal<select id="inbox-channel" class="not-chosen form-control"><option value="">Todos os canais</option><option value="whatsapp">WhatsApp</option><option value="instagram">Instagram</option><option value="facebook">Facebook / Messenger</option></select></label>
                <label class="inbox-check"><input id="inbox-needs-response" type="checkbox"> Aguardando resposta</label>
            </div>
            <div class="inbox-list-scroll"><div id="inbox-list-status" class="inbox-state">Carregando conversas…</div><div id="inbox-list" class="inbox-list"></div><button id="inbox-more" class="btn btn-default btn-sm hide">Carregar mais</button></div>
        </section>
        <main class="inbox-thread">
            <div id="inbox-empty" class="inbox-empty"><div class="inbox-empty-symbol" data-icon="chat"></div><h3>Seu atendimento, em um só lugar.</h3><p>Selecione uma conversa para ver o histórico<br>e continuar o atendimento.</p></div>
            <div id="inbox-selected" class="hide">
                <header class="inbox-thread-header">
                    <button id="inbox-back" class="inbox-icon-button" aria-label="Voltar para conversas"><span data-icon="back"></span></button>
                    <div id="inbox-header-avatar" class="inbox-avatar"></div><div class="inbox-thread-identity"><h3 id="inbox-contact-name"></h3><p id="inbox-context"></p></div>
                    <div class="inbox-actions"><button id="inbox-take" class="btn btn-primary btn-sm">Assumir conversa</button><button id="inbox-resolve" class="btn btn-primary btn-sm">Resolver</button><button id="inbox-reopen" class="btn btn-default btn-sm hide">Reabrir</button><button id="inbox-contact-toggle" class="inbox-icon-button" aria-expanded="true" title="Detalhes do contato" aria-label="Detalhes do contato"><span data-icon="panel"></span></button></div>
                </header>
                <div class="inbox-thread-body">
                    <section class="inbox-messages-wrap" aria-label="Histórico da conversa"><div class="inbox-history-heading"><span data-icon="lock"></span> Histórico da conversa</div><button id="inbox-older" class="btn btn-link btn-sm hide">Carregar mensagens anteriores</button><div id="inbox-timeline" class="inbox-timeline" aria-live="polite"></div></section>
                    <aside id="inbox-contact-panel" class="inbox-contact-panel" aria-label="Detalhes do contato">
                        <div class="inbox-profile"><div id="inbox-profile-avatar" class="inbox-avatar large"></div><h3 id="inbox-profile-name"></h3><span id="inbox-profile-handle"></span><div id="inbox-contact-card"></div></div>
                        <section class="inbox-detail-section"><h4>Conversa</h4><div class="inbox-detail-row"><span>Situação</span><span id="inbox-lifecycle-badge" class="inbox-pill"></span></div><label class="inbox-field-label" for="inbox-transfer">Responsável</label><select id="inbox-transfer" class="not-chosen form-control" aria-label="Transferir para"><option value="">Transferir atendimento…</option><option value="unassign">Devolver à fila</option>{% for user in users %}<option value="{{ user.id }}">{{ user.name }}</option>{% endfor %}</select><div id="inbox-assignee-label" class="inbox-secondary"></div><div class="inbox-detail-row"><span>Caixa de entrada</span></div><div id="inbox-channel-card" class="inbox-channel-card"></div></section>
                        <section class="inbox-detail-section"><h4>Próxima ação</h4><div class="inbox-snooze-controls"><select id="inbox-snooze-duration" class="not-chosen form-control" aria-label="Prazo para adiar"><option value="60">Em 1 hora</option><option value="240">Em 4 horas</option><option value="tomorrow">Amanhã, 9h</option></select><button id="inbox-snooze" class="btn btn-default" title="Adiar conversa">Adiar</button></div><div class="inbox-takeover"><span data-icon="shield"></span><span id="inbox-takeover-text">Automação disponível</span></div></section>
                        <section id="inbox-origin-section" class="inbox-detail-section hide"><h4>Origem do atendimento</h4><div id="inbox-origin-card"></div></section>
                    </aside>
                </div>
                <footer class="inbox-composer">
                    <div class="inbox-composer-top"><div class="inbox-composer-tabs"><button class="active" data-mode="reply"><span data-icon="reply"></span>Resposta privada</button><button data-mode="note"><span data-icon="note"></span>Nota interna</button></div><span id="inbox-composer-channel" class="inbox-secondary"></span></div>
                    <div id="inbox-reply-hint" class="inbox-reply-hint" role="status"></div><div id="inbox-feedback" role="alert"></div>
                    <textarea id="inbox-composer-text" maxlength="4000" rows="3" placeholder="Escreva sua resposta…" aria-label="Texto da resposta"></textarea>
                    <div class="inbox-composer-footer"><div class="inbox-composer-tools"><span data-icon="bolt"></span><select class="not-chosen" id="inbox-canned" aria-label="Inserir resposta pronta"><option value="">Respostas prontas</option>{% for item in cannedResponses %}<option value="{{ item.id }}" data-body="{{ item.body|e('html_attr') }}">{{ item.name }}</option>{% endfor %}</select></div><button id="inbox-send" class="btn btn-primary">Enviar resposta</button></div>
                    <div class="inbox-editor-status"><span id="inbox-draft-state">Rascunho salvo automaticamente</span><span>⌘ / Ctrl + Enter para enviar</span></div>
                </footer>
            </div>
        </main>
    </div>

    <section id="inbox-automation" class="inbox-automation hide">
        <div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title">Regras de comentários do Instagram</h3></div><div class="panel-body">
            <p>As regras complexas continuam nas Campanhas do Mautic. Aqui aparecem as regras de comentário já configuradas; nenhuma campanha é ativada por esta tela.</p>
            <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Campanha</th><th>Regra</th><th>Ativo Meta</th><th>Mídia</th><th>Estado</th><th></th></tr></thead><tbody>
            {% for rule in automationRules %}<tr><td>{{ rule.campaign }}</td><td>{{ rule.name }}</td><td>{{ rule.asset_id }}</td><td><code>{{ rule.media_id }}</code></td><td>{{ rule.published ? 'Publicada' : 'Pausada' }}</td><td><a class="btn btn-default btn-xs" href="{{ rule.url }}">Abrir campanha</a></td></tr>{% else %}<tr><td colspan="6" class="text-muted">Nenhuma regra de comentário configurada.</td></tr>{% endfor %}
            </tbody></table></div>
        </div>
        <div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title">Respostas prontas</h3></div><div class="panel-body"><form id="inbox-canned-form" class="form-inline"><input name="name" class="form-control" maxlength="100" required placeholder="Nome"><input name="body" class="form-control inbox-canned-body" maxlength="4000" required placeholder="Texto da resposta"><button class="btn btn-primary" type="submit">Salvar resposta</button></form><p class="help-block">As respostas prontas apenas preenchem o editor; o atendente revisa e envia.</p></div></div>
    </section>
</div>
{{ includeScript('plugins/MauticInboxBundle/Assets/js/inbox.js?inbox=20260913-alerts-1', 'inboxOnLoad', 'inboxOnLoad') }}
{% endblock %}
