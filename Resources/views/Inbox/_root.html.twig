{# standalone: o shell instalavel nao tem o menu do Mautic em volta, entao o menu do app
   precisa levar tambem para a pagina de agentes. Em /s/inbox aquele caminho ja existe no
   menu lateral, e repeti-lo aqui seria um segundo caminho para o mesmo lugar. #}
<div id="inbox-app" data-standalone="{{ standalone|default(false) ? 1 : 0 }}" data-ai-page-url="{{ path('mautic_inbox_ai') }}" data-ai-url="{{ path('mautic_inbox_ai_available', {stateId:0}) }}" data-locale="{{ app.request.locale|e('html_attr') }}" data-translations="{{ uiTranslations|json_encode|e('html_attr') }}" class="inbox-app"
     data-ai-retry-url="{{ path('mautic_inbox_ai_retry', {stateId:0}) }}"
     data-index-url="{{ path('mautic_inbox_index') }}"
     data-conversation-url="{{ path('mautic_inbox_conversation', {stateId: 0}) }}"
     data-initial-state-id="{{ initialStateId|default(0) }}"
     data-stream-url="{{ path('mautic_inbox_stream') }}"
     data-list-url="{{ path('mautic_inbox_list') }}"
     data-detail-url="{{ path('mautic_inbox_detail', {stateId: 0}) }}"
     data-timeline-url="{{ path('mautic_inbox_timeline', {stateId: 0}) }}"
     data-poll-url="{{ path('mautic_inbox_poll') }}"
     data-take-url="{{ path('mautic_inbox_take', {stateId: 0}) }}"
     data-state-url="{{ path('mautic_inbox_state', {stateId: 0}) }}"
     data-templates-url="{{ path('mautic_inbox_templates', {stateId:0}) }}"
     data-reply-url="{{ path('mautic_inbox_reply', {stateId: 0}) }}"
     data-retry-url="{{ path('mautic_inbox_retry', {outboundId: 0}) }}"
     data-note-url="{{ path('mautic_inbox_note', {stateId: 0}) }}"
     data-draft-url="{{ path('mautic_inbox_draft', {stateId: 0}) }}"
     data-push-config-url="{{ path('mautic_inbox_push_config') }}"
     data-push-subscriptions-url="{{ path('mautic_inbox_push_subscribe') }}"
     data-canned-url="{{ path('mautic_inbox_canned') }}"
     data-canned-item-url="{{ path('mautic_inbox_canned_update', {responseId: 0}) }}"
     data-canned-settings="{{ cannedResponses|json_encode|e('html_attr') }}"
     data-bootstrap="{{ {
         users: users|default([]),
         automationRules: automationRules|default([]),
         channelNotices: channelNotices|default([]),
         canManageCanned: canManageCannedResponses|default(false),
         isAdmin: app.user.isAdmin()
     }|json_encode|e('html_attr') }}"
     data-csrf="{{ csrf_token('mautic_inbox') }}"
     data-current-user="{{ currentUserId }}"></div>
