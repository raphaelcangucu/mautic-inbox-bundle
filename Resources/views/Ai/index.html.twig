{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}inboxai{% endblock %}
{% block headerTitle %}{{ 'mautic.inbox.ai.title'|trans }}{% endblock %}

{% block content %}
{{ includeStylesheet('plugins/MauticInboxBundle/Assets/css/ai.css?ai=20260915-limit2') }}
{% set aiLabelKeys = [
    'title', 'eyebrow', 'subtitle', 'workspace_ready', 'documents', 'pi', 'agents', 'back',
    'new', 'name', 'scope', 'global', 'specific', 'edit', 'preview', 'versions', 'draft',
    'publish', 'published', 'unpublished', 'saved', 'loading', 'install', 'detect',
    'authenticate', 'validate', 'ready', 'pending', 'installed', 'missing', 'model', 'enabled',
    'save', 'permissions', 'messages', 'comments', 'context', 'inherit', 'publish_hint',
    'test_hint', 'restore', 'confirm', 'blocked', 'cms', 'auth', 'active', 'inactive',
    'channels', 'documents_hint', 'agent_selected', 'behavior', 'behavior_hint', 'enabled_hint',
    'context_preview', 'permissions_hint', 'save_hint', 'profile', 'profile_support_hint',
    'profile_sports_hint', 'global_short', 'agent_short', 'characters', 'selected', 'unlimited',
    'unlimited_hint', 'limit', 'limit_hint', 'audience', 'audience_customer', 'audience_internal', 'internal_hint', 'customer_hint', 'mcp_connection', 'mcp_current', 'mcp_identity_hint', 'mcp_tools', 'mcp_read_only', 'internal_roles', 'internal_roles_hint', 'tool_campaign_search', 'tool_campaign_fetch', 'tool_contact_search', 'tool_contact_fetch', 'tool_inbox_context', 'tool_inbox_read', 'tool_campaign_flow', 'tool_campaign_report', 'tool_campaign_comments', 'tool_inbox_reply', 'tool_campaign_update', 'tool_campaign_contacts', 'tool_inbox_transfer'
] %}
{% set aiLabels = {} %}
{% for key in aiLabelKeys %}
    {% set aiLabels = aiLabels|merge({(key): ('mautic.inbox.ai.' ~ key)|trans}) %}
{% endfor %}
<div
    id="inbox-ai"
    data-labels="{{ aiLabels|json_encode|e('html_attr') }}"
    data-url="{{ path('mautic_inbox_ai_data') }}"
    data-action="{{ path('mautic_inbox_ai_action') }}"
    data-inbox-url="{{ path('mautic_inbox_index') }}"
    data-csrf="{{ csrf_token('mautic_inbox') }}"
></div>
{{ includeScript('plugins/MauticInboxBundle/Assets/dist/inbox-app.js?ai=20261007-internal1', 'inboxaiOnLoad', 'inboxaiOnLoad') }}
{% endblock %}
