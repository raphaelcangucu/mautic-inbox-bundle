{% extends '@MauticCore/Default/content.html.twig' %}
{% block mauticContent %}inboxai{% endblock %}
{% block headerTitle %}{{ 'mautic.inbox.ai.title'|trans }}{% endblock %}
{% block content %}
{{ includeStylesheet('plugins/MauticInboxBundle/Assets/css/ai.css?v=5') }}
{% set aiLabels = {'title':'mautic.inbox.ai.title'|trans,'documents':'mautic.inbox.ai.documents'|trans,'pi':'mautic.inbox.ai.pi'|trans,'agents':'mautic.inbox.ai.agents'|trans,'back':'mautic.inbox.ai.back'|trans,'new':'mautic.inbox.ai.new'|trans,'name':'mautic.inbox.ai.name'|trans,'scope':'mautic.inbox.ai.scope'|trans,'global':'mautic.inbox.ai.global'|trans,'specific':'mautic.inbox.ai.specific'|trans,'edit':'mautic.inbox.ai.edit'|trans,'preview':'mautic.inbox.ai.preview'|trans,'versions':'mautic.inbox.ai.versions'|trans,'draft':'mautic.inbox.ai.draft'|trans,'publish':'mautic.inbox.ai.publish'|trans,'published':'mautic.inbox.ai.published'|trans,'unpublished':'mautic.inbox.ai.unpublished'|trans,'saved':'mautic.inbox.ai.saved'|trans,'loading':'mautic.inbox.ai.loading'|trans,'install':'mautic.inbox.ai.install'|trans,'detect':'mautic.inbox.ai.detect'|trans,'authenticate':'mautic.inbox.ai.authenticate'|trans,'validate':'mautic.inbox.ai.validate'|trans,'ready':'mautic.inbox.ai.ready'|trans,'pending':'mautic.inbox.ai.pending'|trans,'installed':'mautic.inbox.ai.installed'|trans,'missing':'mautic.inbox.ai.missing'|trans,'model':'mautic.inbox.ai.model'|trans,'profile':'mautic.inbox.ai.profile'|trans,'enabled':'mautic.inbox.ai.enabled'|trans,'limit':'mautic.inbox.ai.limit'|trans,'save':'mautic.inbox.ai.save'|trans,'permissions':'mautic.inbox.ai.permissions'|trans,'messages':'mautic.inbox.ai.messages'|trans,'comments':'mautic.inbox.ai.comments'|trans,'context':'mautic.inbox.ai.context'|trans,'inherit':'mautic.inbox.ai.inherit'|trans,'publish_hint':'mautic.inbox.ai.publish_hint'|trans,'limit_hint':'mautic.inbox.ai.limit_hint'|trans,'test_hint':'mautic.inbox.ai.test_hint'|trans,'restore':'mautic.inbox.ai.restore'|trans,'ai_assign':'mautic.inbox.ai.ai_assign'|trans,'choose':'mautic.inbox.ai.choose'|trans,'confirm':'mautic.inbox.ai.confirm'|trans,'human':'mautic.inbox.ai.human'|trans,'close':'mautic.inbox.ai.close'|trans,'limit_action':'mautic.inbox.ai.limit_action'|trans,'blocked':'mautic.inbox.ai.blocked'|trans,'cms':'mautic.inbox.ai.cms'|trans,'auth':'mautic.inbox.ai.auth'|trans,'conflict':'mautic.inbox.ai.conflict'|trans,'context_large':'mautic.inbox.ai.context_large'|trans,'document_invalid':'mautic.inbox.ai.document_invalid'|trans,'pi_failed':'mautic.inbox.ai.pi_failed'|trans,'install_failed':'mautic.inbox.ai.install_failed'|trans,'not_allowed':'mautic.inbox.ai.not_allowed'|trans,'validate_first':'mautic.inbox.ai.validate_first'|trans,'take_first':'mautic.inbox.ai.take_first'|trans,'limit_reached':'mautic.inbox.ai.limit_reached'|trans,'transfer_limit':'mautic.inbox.ai.transfer_limit'|trans,'model_invalid':'mautic.inbox.ai.model_invalid'|trans,'invalid_action':'mautic.inbox.ai.invalid_action'|trans,'active':'mautic.inbox.ai.active'|trans,'inactive':'mautic.inbox.ai.inactive'|trans,'channels':'mautic.inbox.ai.channels'|trans,'profile_support_hint':'mautic.inbox.ai.profile_support_hint'|trans,'profile_sports_hint':'mautic.inbox.ai.profile_sports_hint'|trans,'global_short':'mautic.inbox.ai.global_short'|trans,'agent_short':'mautic.inbox.ai.agent_short'|trans,'characters':'mautic.inbox.ai.characters'|trans,'selected':'mautic.inbox.ai.selected'|trans} %}
<div id="inbox-ai" data-labels="{{ aiLabels|json_encode|e('html_attr') }}" data-url="{{ path('mautic_inbox_ai_data') }}" data-action="{{ path('mautic_inbox_ai_action') }}" data-csrf="{{ csrf_token('mautic_inbox') }}">
<header class="ai-header"><div class="ai-heading"><span class="ai-mark" aria-hidden="true"><i class="ri-sparkling-2-line"></i></span><div><span class="ai-kicker">{{ 'mautic.inbox.ai.eyebrow'|trans }}</span><h2>{{ 'mautic.inbox.ai.title'|trans }}</h2><p>{{ 'mautic.inbox.ai.subtitle'|trans }}</p></div></div><div class="ai-header-actions"><span class="ai-live-pill"><i></i>{{ 'mautic.inbox.ai.workspace_ready'|trans }}</span><a class="btn btn-default" href="{{ path('mautic_inbox_index') }}">← {{ 'mautic.inbox.ai.back'|trans }}</a></div></header>
<nav class="ai-tabs" aria-label="{{ 'mautic.inbox.ai.title'|trans }}">{% for tab in ['documents','pi','agents'] %}<button class="btn btn-default" data-ai-tab="{{ tab }}"><span class="ai-tab-index">0{{ loop.index }}</span>{{ ('mautic.inbox.ai.'~tab)|trans }}</button>{% endfor %}</nav><div id="ai-feedback" role="status"></div>
<section data-ai-panel="documents"><div class="ai-panel-heading"><div><h3>{{ 'mautic.inbox.ai.documents'|trans }}</h3><p>{{ 'mautic.inbox.ai.documents_hint'|trans }}</p></div><button id="ai-new-doc" class="btn btn-primary"><span aria-hidden="true">＋</span> {{ 'mautic.inbox.ai.new'|trans }}</button></div><div class="ai-doc-layout"><aside class="ai-doc-sidebar"><div id="ai-doc-list"></div></aside><div class="ai-card ai-editor-card"><div class="ai-grid"><label>{{ 'mautic.inbox.ai.name'|trans }}<input class="form-control" id="ai-doc-name" maxlength="100"></label><label>{{ 'mautic.inbox.ai.scope'|trans }}<select id="ai-doc-scope" class="form-control not-chosen"><option value="global">{{ 'mautic.inbox.ai.global'|trans }}</option><option value="agent">{{ 'mautic.inbox.ai.specific'|trans }}</option></select></label></div><div class="ai-editor-tabs"><button class="btn btn-default" id="ai-doc-edit">{{ 'mautic.inbox.ai.edit'|trans }}</button><button class="btn btn-default" id="ai-doc-preview-button">{{ 'mautic.inbox.ai.preview'|trans }}</button><button class="btn btn-default" id="ai-doc-versions-button">{{ 'mautic.inbox.ai.versions'|trans }}</button><span id="ai-doc-version" class="ai-badge"></span></div><textarea id="ai-doc-body" class="form-control" rows="17" maxlength="60000" aria-label="Markdown"></textarea><div id="ai-doc-preview" hidden></div><div id="ai-doc-versions" hidden></div><div class="ai-savebar"><p class="ai-muted">{{ 'mautic.inbox.ai.publish_hint'|trans }}</p><div><button id="ai-doc-save" class="btn btn-default">{{ 'mautic.inbox.ai.draft'|trans }}</button><button id="ai-doc-publish" class="btn btn-primary">{{ 'mautic.inbox.ai.publish'|trans }}</button></div></div></div></div></section>
<section data-ai-panel="pi" hidden><div class="ai-card"><h3>{{ 'mautic.inbox.ai.pi'|trans }}</h3><div id="ai-health" class="ai-health"></div><div class="ai-toolbar"><button id="ai-install" class="btn btn-default">{{ 'mautic.inbox.ai.install'|trans }}</button><button data-pi-action="health" class="btn btn-default">{{ 'mautic.inbox.ai.detect'|trans }}</button><button data-pi-action="import-auth" class="btn btn-default">{{ 'mautic.inbox.ai.authenticate'|trans }}</button><button data-pi-action="validate" class="btn btn-primary">{{ 'mautic.inbox.ai.validate'|trans }}</button></div><p class="ai-muted">{{ 'mautic.inbox.ai.test_hint'|trans }}</p></div><div class="ai-card"><div class="ai-grid"><label>{{ 'mautic.inbox.ai.model'|trans }}<select id="ai-model" class="form-control not-chosen"></select></label><div class="ai-unlimited"><span aria-hidden="true">∞</span><div><strong>{{ 'mautic.inbox.ai.unlimited'|trans }}</strong><small>{{ 'mautic.inbox.ai.unlimited_hint'|trans }}</small></div></div><label><input type="checkbox" id="ai-global-enabled"> {{ 'mautic.inbox.ai.enabled'|trans }}</label></div><h3>{{ 'mautic.inbox.ai.permissions'|trans }}</h3><div id="ai-global-permissions"></div><button id="ai-config-save" class="btn btn-primary">{{ 'mautic.inbox.ai.save'|trans }}</button></div></section>
<section data-ai-panel="agents" hidden><div class="ai-agent-toolbar"><div><span class="ai-section-label">{{ 'mautic.inbox.ai.agent_selected'|trans }}</span><select id="ai-agent-select" class="form-control not-chosen"></select></div><div class="ai-agent-toolbar-actions"><button id="ai-new-agent" class="btn btn-default"><span aria-hidden="true">＋</span> {{ 'mautic.inbox.ai.new'|trans }}</button><button id="ai-agent-save-top" class="btn btn-primary">{{ 'mautic.inbox.ai.save'|trans }}</button></div></div><div class="ai-agent-summary"><div class="ai-agent-avatar" aria-hidden="true">AI</div><div class="ai-agent-summary-name"><strong id="ai-agent-summary-name"></strong><span id="ai-agent-summary-profile"></span></div><div class="ai-summary-stat"><strong id="ai-agent-summary-docs">0</strong><span>{{ 'mautic.inbox.ai.documents'|trans }}</span></div><div class="ai-summary-stat"><strong id="ai-agent-summary-permissions">0</strong><span>{{ 'mautic.inbox.ai.channels'|trans }}</span></div><span id="ai-agent-status" class="ai-status-pill"></span></div><div class="ai-grid ai-agent-grid"><div class="ai-card"><div class="ai-card-heading"><span class="ai-card-icon" aria-hidden="true">◎</span><div><h3>{{ 'mautic.inbox.ai.behavior'|trans }}</h3><p>{{ 'mautic.inbox.ai.behavior_hint'|trans }}</p></div></div><label>{{ 'mautic.inbox.ai.name'|trans }}<input id="ai-agent-name" class="form-control" maxlength="100"></label><label>{{ 'mautic.inbox.ai.profile'|trans }}<select id="ai-agent-profile" class="form-control not-chosen"><option>macro-support</option><option>macro-sports</option></select></label><p id="ai-agent-profile-hint" class="ai-field-hint"></p><div class="ai-inline-options"><div class="ai-unlimited compact"><span aria-hidden="true">∞</span><div><strong>{{ 'mautic.inbox.ai.unlimited'|trans }}</strong><small>{{ 'mautic.inbox.ai.unlimited_hint'|trans }}</small></div></div><label class="ai-switch-row"><span><strong>{{ 'mautic.inbox.ai.enabled'|trans }}</strong><small>{{ 'mautic.inbox.ai.enabled_hint'|trans }}</small></span><input type="checkbox" id="ai-agent-enabled"></label></div></div><div class="ai-card"><div class="ai-card-heading"><span class="ai-card-icon" aria-hidden="true">≡</span><div><h3>{{ 'mautic.inbox.ai.context'|trans }}</h3><p>{{ 'mautic.inbox.ai.inherit'|trans }}</p></div></div><div id="ai-agent-docs" class="ai-document-checklist"></div><details class="ai-context-details"><summary><span>{{ 'mautic.inbox.ai.context_preview'|trans }}</span><small id="ai-agent-context-size"></small></summary><pre id="ai-agent-context"></pre></details></div></div><div class="ai-card ai-permissions-card"><div class="ai-card-heading"><span class="ai-card-icon" aria-hidden="true">⌁</span><div><h3>{{ 'mautic.inbox.ai.permissions'|trans }}</h3><p>{{ 'mautic.inbox.ai.permissions_hint'|trans }}</p></div></div><div id="ai-agent-permissions"></div></div><div class="ai-savebar ai-agent-savebar"><p><strong id="ai-save-summary"></strong><span>{{ 'mautic.inbox.ai.save_hint'|trans }}</span></p><button id="ai-agent-save" class="btn btn-primary">{{ 'mautic.inbox.ai.save'|trans }}</button></div></section>
</div>{{ includeScript('plugins/MauticInboxBundle/Assets/js/ai.js?v=5','inboxaiOnLoad','inboxaiOnLoad') }}
{% endblock %}
