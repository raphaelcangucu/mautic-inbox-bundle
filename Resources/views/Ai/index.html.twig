{% extends '@MauticCore/Default/content.html.twig' %}
{% block mauticContent %}inboxai{% endblock %}
{% block headerTitle %}{{ 'mautic.inbox.ai.title'|trans }}{% endblock %}
{% block content %}
{{ includeStylesheet('plugins/MauticInboxBundle/Assets/css/ai.css?v=3') }}
{% set aiLabels = {'title':'mautic.inbox.ai.title'|trans,'documents':'mautic.inbox.ai.documents'|trans,'pi':'mautic.inbox.ai.pi'|trans,'agents':'mautic.inbox.ai.agents'|trans,'back':'mautic.inbox.ai.back'|trans,'new':'mautic.inbox.ai.new'|trans,'name':'mautic.inbox.ai.name'|trans,'scope':'mautic.inbox.ai.scope'|trans,'global':'mautic.inbox.ai.global'|trans,'specific':'mautic.inbox.ai.specific'|trans,'edit':'mautic.inbox.ai.edit'|trans,'preview':'mautic.inbox.ai.preview'|trans,'versions':'mautic.inbox.ai.versions'|trans,'draft':'mautic.inbox.ai.draft'|trans,'publish':'mautic.inbox.ai.publish'|trans,'published':'mautic.inbox.ai.published'|trans,'unpublished':'mautic.inbox.ai.unpublished'|trans,'saved':'mautic.inbox.ai.saved'|trans,'loading':'mautic.inbox.ai.loading'|trans,'install':'mautic.inbox.ai.install'|trans,'detect':'mautic.inbox.ai.detect'|trans,'authenticate':'mautic.inbox.ai.authenticate'|trans,'validate':'mautic.inbox.ai.validate'|trans,'ready':'mautic.inbox.ai.ready'|trans,'pending':'mautic.inbox.ai.pending'|trans,'installed':'mautic.inbox.ai.installed'|trans,'missing':'mautic.inbox.ai.missing'|trans,'model':'mautic.inbox.ai.model'|trans,'profile':'mautic.inbox.ai.profile'|trans,'enabled':'mautic.inbox.ai.enabled'|trans,'limit':'mautic.inbox.ai.limit'|trans,'save':'mautic.inbox.ai.save'|trans,'permissions':'mautic.inbox.ai.permissions'|trans,'messages':'mautic.inbox.ai.messages'|trans,'comments':'mautic.inbox.ai.comments'|trans,'context':'mautic.inbox.ai.context'|trans,'inherit':'mautic.inbox.ai.inherit'|trans,'publish_hint':'mautic.inbox.ai.publish_hint'|trans,'limit_hint':'mautic.inbox.ai.limit_hint'|trans,'test_hint':'mautic.inbox.ai.test_hint'|trans,'restore':'mautic.inbox.ai.restore'|trans,'ai_assign':'mautic.inbox.ai.ai_assign'|trans,'choose':'mautic.inbox.ai.choose'|trans,'confirm':'mautic.inbox.ai.confirm'|trans,'human':'mautic.inbox.ai.human'|trans,'close':'mautic.inbox.ai.close'|trans,'limit_action':'mautic.inbox.ai.limit_action'|trans,'blocked':'mautic.inbox.ai.blocked'|trans,'cms':'mautic.inbox.ai.cms'|trans,'auth':'mautic.inbox.ai.auth'|trans,'conflict':'mautic.inbox.ai.conflict'|trans,'context_large':'mautic.inbox.ai.context_large'|trans,'document_invalid':'mautic.inbox.ai.document_invalid'|trans,'pi_failed':'mautic.inbox.ai.pi_failed'|trans,'install_failed':'mautic.inbox.ai.install_failed'|trans,'not_allowed':'mautic.inbox.ai.not_allowed'|trans,'validate_first':'mautic.inbox.ai.validate_first'|trans,'take_first':'mautic.inbox.ai.take_first'|trans,'limit_reached':'mautic.inbox.ai.limit_reached'|trans,'transfer_limit':'mautic.inbox.ai.transfer_limit'|trans,'model_invalid':'mautic.inbox.ai.model_invalid'|trans,'invalid_action':'mautic.inbox.ai.invalid_action'|trans} %}
<div id="inbox-ai" data-labels="{{ aiLabels|json_encode|e('html_attr') }}" data-url="{{ path('mautic_inbox_ai_data') }}" data-action="{{ path('mautic_inbox_ai_action') }}" data-csrf="{{ csrf_token('mautic_inbox') }}">
<header class="ai-header"><div class="ai-heading"><span class="ai-mark" aria-hidden="true">AI</span><div><span class="ai-kicker">{{ 'mautic.inbox.ai.eyebrow'|trans }}</span><h2>{{ 'mautic.inbox.ai.title'|trans }}</h2><p>{{ 'mautic.inbox.ai.subtitle'|trans }}</p></div></div><a class="btn btn-default" href="{{ path('mautic_inbox_index') }}">← {{ 'mautic.inbox.ai.back'|trans }}</a></header>
<nav class="ai-tabs" aria-label="{{ 'mautic.inbox.ai.title'|trans }}">{% for tab in ['documents','pi','agents'] %}<button class="btn btn-default" data-ai-tab="{{ tab }}"><span class="ai-tab-index">0{{ loop.index }}</span>{{ ('mautic.inbox.ai.'~tab)|trans }}</button>{% endfor %}</nav><div id="ai-feedback" role="status"></div>
<section data-ai-panel="documents"><div class="ai-toolbar"><button id="ai-new-doc" class="btn btn-primary">+ {{ 'mautic.inbox.ai.new'|trans }}</button></div><div class="ai-doc-layout"><aside id="ai-doc-list"></aside><div class="ai-card"><div class="ai-grid"><label>{{ 'mautic.inbox.ai.name'|trans }}<input class="form-control" id="ai-doc-name" maxlength="100"></label><label>{{ 'mautic.inbox.ai.scope'|trans }}<select id="ai-doc-scope" class="form-control not-chosen"><option value="global">{{ 'mautic.inbox.ai.global'|trans }}</option><option value="agent">{{ 'mautic.inbox.ai.specific'|trans }}</option></select></label></div><div class="ai-toolbar"><button class="btn btn-default" id="ai-doc-edit">{{ 'mautic.inbox.ai.edit'|trans }}</button><button class="btn btn-default" id="ai-doc-preview-button">{{ 'mautic.inbox.ai.preview'|trans }}</button><button class="btn btn-default" id="ai-doc-versions-button">{{ 'mautic.inbox.ai.versions'|trans }}</button><span id="ai-doc-version" class="ai-badge"></span></div><textarea id="ai-doc-body" class="form-control" rows="17" maxlength="60000" aria-label="Markdown"></textarea><div id="ai-doc-preview" hidden></div><div id="ai-doc-versions" hidden></div><div class="ai-toolbar"><button id="ai-doc-save" class="btn btn-default">{{ 'mautic.inbox.ai.draft'|trans }}</button><button id="ai-doc-publish" class="btn btn-primary">{{ 'mautic.inbox.ai.publish'|trans }}</button></div><p class="ai-muted">{{ 'mautic.inbox.ai.publish_hint'|trans }}</p></div></div></section>
<section data-ai-panel="pi" hidden><div class="ai-card"><h3>{{ 'mautic.inbox.ai.pi'|trans }}</h3><div id="ai-health" class="ai-health"></div><div class="ai-toolbar"><button id="ai-install" class="btn btn-default">{{ 'mautic.inbox.ai.install'|trans }}</button><button data-pi-action="health" class="btn btn-default">{{ 'mautic.inbox.ai.detect'|trans }}</button><button data-pi-action="import-auth" class="btn btn-default">{{ 'mautic.inbox.ai.authenticate'|trans }}</button><button data-pi-action="validate" class="btn btn-primary">{{ 'mautic.inbox.ai.validate'|trans }}</button></div><p class="ai-muted">{{ 'mautic.inbox.ai.test_hint'|trans }}</p></div><div class="ai-card"><div class="ai-grid"><label>{{ 'mautic.inbox.ai.model'|trans }}<select id="ai-model" class="form-control not-chosen"></select></label><div class="ai-unlimited"><span aria-hidden="true">∞</span><div><strong>{{ 'mautic.inbox.ai.unlimited'|trans }}</strong><small>{{ 'mautic.inbox.ai.unlimited_hint'|trans }}</small></div></div><label><input type="checkbox" id="ai-global-enabled"> {{ 'mautic.inbox.ai.enabled'|trans }}</label></div><h3>{{ 'mautic.inbox.ai.permissions'|trans }}</h3><div id="ai-global-permissions"></div><button id="ai-config-save" class="btn btn-primary">{{ 'mautic.inbox.ai.save'|trans }}</button></div></section>
<section data-ai-panel="agents" hidden><div class="ai-toolbar"><select id="ai-agent-select" class="form-control not-chosen"></select><button id="ai-new-agent" class="btn btn-default">+ {{ 'mautic.inbox.ai.new'|trans }}</button></div><div class="ai-grid"><div class="ai-card"><label>{{ 'mautic.inbox.ai.name'|trans }}<input id="ai-agent-name" class="form-control" maxlength="100"></label><label>{{ 'mautic.inbox.ai.profile'|trans }}<select id="ai-agent-profile" class="form-control not-chosen"><option>macro-support</option><option>macro-sports</option></select></label><div class="ai-unlimited compact"><span aria-hidden="true">∞</span><div><strong>{{ 'mautic.inbox.ai.unlimited'|trans }}</strong><small>{{ 'mautic.inbox.ai.unlimited_hint'|trans }}</small></div></div><label><input type="checkbox" id="ai-agent-enabled"> {{ 'mautic.inbox.ai.enabled'|trans }}</label></div><div class="ai-card"><h3>{{ 'mautic.inbox.ai.context'|trans }}</h3><p class="ai-muted">{{ 'mautic.inbox.ai.inherit'|trans }}</p><div id="ai-agent-docs"></div><details><summary>{{ 'mautic.inbox.ai.preview'|trans }}</summary><pre id="ai-agent-context"></pre></details></div></div><div class="ai-card"><h3>{{ 'mautic.inbox.ai.permissions'|trans }}</h3><div id="ai-agent-permissions"></div><button id="ai-agent-save" class="btn btn-primary">{{ 'mautic.inbox.ai.save'|trans }}</button></div></section>
</div>{{ includeScript('plugins/MauticInboxBundle/Assets/js/ai.js?v=3','inboxaiOnLoad','inboxaiOnLoad') }}
{% endblock %}
