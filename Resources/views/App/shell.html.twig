<!DOCTYPE html>
<html lang="{{ app.request.locale|replace({'_': '-'}) }}">
<head>
<meta charset="utf-8">
{# viewport-fit=cover para o conteudo correr ate a borda em aparelho com entalhe #}
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#4e5e9e">
<title>{{ 'mautic.inbox.ui.support_inbox_fff9ea'|trans }}</title>
<link rel="manifest" href="{{ path('mautic_inbox_manifest') }}">
{# O iOS ignora o manifest para o icone e usa este. #}
<link rel="apple-touch-icon" href="{{ path('mautic_inbox_icon', {name: 'apple-180'}) }}">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Atendimento">
<link rel="icon" href="{{ path('mautic_inbox_icon', {name: '192'}) }}" sizes="192x192" type="image/png">
{{ includeStylesheet('plugins/MauticInboxBundle/Assets/css/inbox.css?app=1') }}
<style>
  /* O shell nao carrega o chrome do Mautic, entao o basico mora aqui. */
  html, body { height: 100%; margin: 0; background: #f6f7fb; }
  body { -webkit-tap-highlight-color: transparent; overscroll-behavior-y: none; }
  .inbox-shell {
    display: flex; flex-direction: column; height: 100%;
    /* Respeita a area segura do aparelho em vez de esconder conteudo sob a barra do sistema. */
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .inbox-shell > #inbox-app { flex: 1 1 auto; min-height: 0; overflow: hidden; }
  .inbox-shell-nav {
    display: flex; flex: none; border-top: 1px solid #dfe3ec; background: #fff;
  }
  .inbox-shell-nav a {
    flex: 1; padding: 10px 4px 12px; text-align: center; text-decoration: none;
    color: #5a6573; font: 500 12px/1.3 system-ui, sans-serif;
  }
  .inbox-shell-nav a[aria-current="page"] { color: #4e5e9e; }
  .inbox-shell-nav span { display: block; font-size: 18px; line-height: 1.1; }
</style>
</head>
<body>
<div class="inbox-shell">
{{ include('@MauticInbox/Inbox/_root.html.twig') }}
{% if isAdmin|default(false) %}
<nav class="inbox-shell-nav">
  <a href="{{ path('mautic_inbox_app') }}" aria-current="page"><span aria-hidden="true">💬</span>{{ 'mautic.inbox.ui.conversations_86d0e6'|trans }}</a>
  <a href="{{ path('mautic_inbox_ai') }}"><span aria-hidden="true">🤖</span>{{ 'mautic.inbox.ai.agents'|trans }}</a>
</nav>
{% endif %}
</div>
<script src="{{ asset('plugins/MauticInboxBundle/Assets/dist/inbox-app.js') }}?app=1"></script>
<script>
  // O bundle expoe inboxOnLoad para o ciclo de navegacao do Mautic. Aqui nao ha aquele ciclo,
  // entao a montagem e direta.
  if (typeof window.inboxOnLoad === 'function') { window.inboxOnLoad(); }
</script>
</body>
</html>
