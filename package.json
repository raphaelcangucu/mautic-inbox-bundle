{
  "name": "@macro-markets/mautic-inbox-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.sw.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format:check": "prettier --plugin=prettier-plugin-svelte --check \"Frontend/**/*.{ts,svelte}\" \"Tests/JavaScript/*.{mjs,ts}\" package.json tsconfig.json vite.config.ts svelte.config.js",
    "test": "npm run format:check && npm run check && npm run build && node --test Tests/JavaScript/*.test.mjs && tsx --test Tests/JavaScript/*.unit.test.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "jsdom": "27.0.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte": "5.57.0",
    "svelte-check": "4.3.5",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
